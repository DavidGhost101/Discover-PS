rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && currentUser().data.role == "ADMIN";
    }

    function isTeacher() {
      return signedIn()
        && currentUser().data.role == "TEACHER";
    }

    function sameSchool(schoolId) {
      return signedIn()
        && currentUser().data.schoolId == schoolId;
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role != "ADMIN");

      allow update: if isAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.schoolId == resource.data.schoolId
        );

      allow delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if signedIn()
        && sameSchool(resource.data.schoolId);
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if signedIn()
        && sameSchool(resource.data.schoolId);
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn()
        && sameSchool(resource.data.schoolId);
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if signedIn()
        && sameSchool(resource.data.schoolId);
      allow write: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn()
        && sameSchool(resource.data.schoolId);
      allow create, update, delete: if (isAdmin() || isTeacher())
        && sameSchool(request.resource.data.schoolId);
    }

    match /notices/{noticeId} {
      allow read: if signedIn()
        && sameSchool(resource.data.schoolId);
      allow create, update, delete: if isAdmin()
        || isTeacher();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
